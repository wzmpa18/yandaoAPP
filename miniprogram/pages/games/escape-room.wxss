.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.header-left {
  width: 80rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
}

.header-center .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.header-right .timer {
  font-size: 32rpx;
  color: #fff;
  background: rgba(255,255,255,0.2);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

.game-info {
  margin: 20rpx 0;
}

.info-row {
  display: flex;
  justify-content: space-around;
}

.info-item {
  text-align: center;
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.info-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.info-value.items {
  font-size: 36rpx;
}

.rooms-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.room-item {
  width: calc(50% - 10rpx);
  background: rgba(255,255,255,0.1);
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  transition: all 0.3s;
}

.room-item:active {
  transform: scale(0.95);
}

.room-item.locked {
  opacity: 0.5;
}

.room-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.room-name {
  display: block;
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 10rpx;
}

.room-status {
  font-size: 24rpx;
  color: #4ade80;
}

.room-item.locked .room-status {
  color: #9ca3af;
}

.puzzle-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
}

.puzzle-content {
  position: relative;
  background: #fff;
  border-radius: 30rpx;
  padding: 40rpx;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
}

.puzzle-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.puzzle-question {
  display: block;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 30rpx;
  line-height: 1.6;
}

.hint-box {
  display: flex;
  align-items: flex-start;
  background: #fef3c7;
  border-radius: 15rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.hint-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
}

.hint-text {
  font-size: 28rpx;
  color: #92400e;
}

.puzzle-options {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 25rpx 30rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 15rpx;
  transition: all 0.2s;
}

.option-item:active {
  background: #eef2ff;
  border-color: #6366f1;
}

.option-letter {
  font-size: 32rpx;
  font-weight: bold;
  color: #6366f1;
  width: 40rpx;
}

.option-text {
  font-size: 30rpx;
  color: #333;
}

.puzzle-actions {
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.btn-secondary {
  background: #fbbf24;
  color: #92400e;
}

.btn-cancel {
  background: #f3f4f6;
  color: #6b7280;
}

.game-over {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  position: relative;
  background: #fff;
  border-radius: 30rpx;
  padding: 50rpx;
  text-align: center;
  width: 85%;
}

.modal-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.modal-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.modal-time {
  display: block;
  font-size: 32rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.modal-score {
  display: block;
  font-size: 36rpx;
  color: #22c55e;
  margin-bottom: 30rpx;
}

.btn-primary {
  background: #22c55e;
  color: #fff;
}