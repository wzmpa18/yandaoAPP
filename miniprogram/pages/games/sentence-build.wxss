.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.header-left {
  width: 80rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
}

.header-center .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.header-right .score {
  font-size: 32rpx;
  color: #fff;
  background: rgba(255,255,255,0.2);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

.game-info {
  margin: 20rpx 0;
}

.info-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.info-item {
  text-align: center;
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.info-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.hint-box {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.2);
  border-radius: 15rpx;
  padding: 20rpx;
}

.hint-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.hint-text {
  font-size: 28rpx;
  color: #fff;
}

.sentence-area {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.area-title {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.selected-words {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  min-height: 80rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 15rpx;
  border: 2rpx dashed #e2e8f0;
}

.selected-word {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background: #3b82f6;
  color: #fff;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.remove-icon {
  margin-left: 10rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.placeholder {
  font-size: 26rpx;
  color: #9ca3af;
}

.words-area {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.word-bank {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.word-item {
  padding: 15rpx 25rpx;
  background: #f0fdf4;
  border: 2rpx solid #4ade80;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #16a34a;
  transition: all 0.2s;
}

.word-item:active {
  transform: scale(0.95);
  background: #dcfce7;
}

.result-section {
  text-align: center;
  margin-bottom: 20rpx;
}

.result-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.result-text {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.correct-answer {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 10rpx;
}

.actions {
  padding-bottom: 40rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 34rpx;
  font-weight: bold;
}

.btn-primary {
  background: #22c55e;
  color: #fff;
}

.game-over {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.modal {
  position: relative;
  background: #fff;
  border-radius: 30rpx;
  padding: 50rpx;
  text-align: center;
  width: 85%;
}

.modal-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.modal-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.modal-score {
  display: block;
  font-size: 36rpx;
  color: #22c55e;
  margin-bottom: 30rpx;
}