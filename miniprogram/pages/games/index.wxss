.page-header {
  text-align: center;
  padding: 40rpx 0;
}

.page-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1e293b;
}

.page-subtitle {
  font-size: 28rpx;
  color: #64748b;
  margin-top: 12rpx;
  display: block;
}

.games-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.game-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.game-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 20rpx;
}

.game-icon.bg-orange {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
}

.game-icon.bg-purple {
  background: linear-gradient(135deg, #a855f7 0%, #9333ea 100%);
}

.game-icon.bg-red {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
}

.game-icon.bg-blue {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
}

.game-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
}

.game-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
  display: block;
}

.game-stats {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
}

.stat-item {
  font-size: 22rpx;
  color: #94a3b8;
}

.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.rank-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  margin-right: 20rpx;
}

.ranking-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.ranking-info {
  flex: 1;
}

.ranking-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
}

.ranking-score {
  font-size: 22rpx;
  color: #22c55e;
}

.ranking-level {
  font-size: 24rpx;
  color: #f59e0b;
  font-weight: 600;
}

.game-rules {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rule-item {
  display: flex;
  align-items: center;
}

.rule-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.rule-text {
  font-size: 26rpx;
  color: #64748b;
}
