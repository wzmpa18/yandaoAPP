.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.header-left {
  width: 80rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
}

.header-center .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.header-right .score {
  font-size: 32rpx;
  color: #fff;
  background: rgba(255,255,255,0.2);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

.game-info {
  margin: 20rpx 0;
}

.time-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.time-label {
  font-size: 28rpx;
  color: #fff;
  width: 120rpx;
}

.time-progress {
  flex: 1;
  height: 20rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 10rpx;
  overflow: hidden;
}

.time-fill {
  height: 100%;
  background: #4ade80;
  transition: width 0.3s;
}

.time-text {
  font-size: 28rpx;
  color: #fff;
  width: 80rpx;
  text-align: right;
}

.words-list {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.words-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.word-item {
  font-size: 26rpx;
  color: #333;
  background: #f0f0f0;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
}

.word-item.found {
  background: #dcfce7;
  color: #16a34a;
}

.grid-container {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.grid {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grid-row {
  display: flex;
}

.cell {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  font-size: 32rpx;
  font-weight: bold;
  color: #334155;
  cursor: pointer;
  transition: all 0.2s;
}

.cell:hover {
  background: #e2e8f0;
}

.cell.selected {
  background: #6366f1;
  color: #fff;
  border-color: #4f46e5;
}

.current-word {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.word-label {
  font-size: 28rpx;
  color: #666;
}

.word-content {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.actions {
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-primary {
  background: #22c55e;
  color: #fff;
}

.btn-secondary {
  background: rgba(255,255,255,0.9);
  color: #666;
}

.game-over {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.modal {
  position: relative;
  background: #fff;
  border-radius: 30rpx;
  padding: 40rpx;
  text-align: center;
  width: 80%;
}

.modal-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.modal-score {
  display: block;
  font-size: 36rpx;
  color: #22c55e;
  margin-bottom: 10rpx;
}

.modal-found {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}