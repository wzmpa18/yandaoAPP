.page-header {
  text-align: center;
  padding: 40rpx 0;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1e293b;
}

.content-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #22c55e;
  margin-bottom: 16rpx;
  display: block;
}

.section-content {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.6;
}

.bullet-list {
  margin-top: 16rpx;
}

.bullet {
  font-size: 26rpx;
  color: #64748b;
  line-height: 2;
  display: block;
}
