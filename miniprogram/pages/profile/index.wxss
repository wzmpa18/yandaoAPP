.profile-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-detail {
  margin-left: 24rpx;
}

.edit-btn {
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #22c55e;
}

.stat-label {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  background: #e2e8f0;
}

.referral-card {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
}

.referral-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.referral-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #92400e;
}

.referral-level {
  background: #f59e0b;
  color: #ffffff;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.referral-rates {
  display: flex;
  gap: 48rpx;
  margin-bottom: 20rpx;
}

.rate-item {
  display: flex;
  flex-direction: column;
}

.rate-label {
  font-size: 24rpx;
  color: #b45309;
}

.rate-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #92400e;
}

.referral-progress {
  margin-top: 20rpx;
}

.referral-progress .progress-bar {
  background: rgba(255, 255, 255, 0.5);
}

.referral-progress .progress-fill {
  background: #f59e0b;
}

.progress-text {
  font-size: 24rpx;
  color: #b45309;
  margin-top: 12rpx;
  display: block;
}

.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #1e293b;
}

.menu-badge {
  font-size: 24rpx;
  color: #22c55e;
  margin-right: 16rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: #94a3b8;
}

.logout-btn {
  text-align: center;
  padding: 28rpx;
  background: #f1f5f9;
  color: #64748b;
  border-radius: 24rpx;
  font-size: 30rpx;
  margin-top: 24rpx;
}
