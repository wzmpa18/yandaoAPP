<view class="container">
  <view class="page-header">
    <text class="page-title">💰 推广员中心</text>
    <text class="page-subtitle">邀请好友，一起学习，共同赚钱</text>
  </view>

  <view class="referral-card">
    <view class="referral-level-badge">{{referralLevel.name}}</view>
    <view class="referral-stats">
      <view class="stat-item">
        <text class="stat-value">{{referralCount}}</text>
        <text class="stat-label">邀请人数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{totalEarnings}}</text>
        <text class="stat-label">累计收益</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{teamCount}}</text>
        <text class="stat-label">团队人数</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <text class="text-xl font-bold">邀请奖励</text>
    </view>
    <view class="reward-info">
      <text class="reward-text">🎁 每邀请1位好友，双方各得 <text class="highlight">7天VIP</text></text>
      <text class="reward-desc">好友完成注册即可获得</text>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <text class="text-xl font-bold">推广员等级</text>
    </view>
    <view class="level-list">
      <view class="level-item" wx:for="{{levels}}" wx:key="name">
        <view class="level-header">
          <text class="level-name">{{item.name}}</text>
          <text class="level-rate">{{item.rate}}%</text>
        </view>
        <text class="level-require">{{item.min}}人以上</text>
        <view class="level-benefit">
          <text>直推佣金 {{item.rate}}%</text>
          <text>间推佣金 5%</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <text class="text-xl font-bold">我的邀请码</text>
    </view>
    <view class="invite-code">
      <text class="code-text">{{inviteCode}}</text>
      <view class="copy-btn" bindtap="copyCode">复制</view>
    </view>
    <view class="share-section">
      <text class="share-title">分享邀请</text>
      <view class="share-buttons">
        <view class="share-btn" bindtap="shareToFriend">
          <text class="share-icon">💬</text>
          <text class="share-text">微信好友</text>
        </view>
        <view class="share-btn" bindtap="shareToGroup">
          <text class="share-icon">👥</text>
          <text class="share-text">微信群</text>
        </view>
        <view class="share-btn" bindtap="shareToQr">
          <text class="share-icon">📱</text>
          <text class="share-text">生成海报</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <text class="text-xl font-bold">收益说明</text>
    </view>
    <view class="rules-list">
      <text class="rule-item">• 小程序端获得的「学习金」不可提现，可用于兑换课程和VIP</text>
      <text class="rule-item">• App端可将收益提现至微信零钱</text>
      <text class="rule-item">• 间推奖励为下级推广收益的5%</text>
      <text class="rule-item">• 推广员等级每日0点更新</text>
    </view>
  </view>
</view>
