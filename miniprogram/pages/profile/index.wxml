<view class="container">
  <view class="profile-header">
    <view class="user-info">
      <view class="avatar avatar-lg">{{userInfo.nickname.charAt(0)}}</view>
      <view class="user-detail">
        <text class="text-xl font-bold">{{userInfo.nickname}}</text>
        <view class="flex items-center gap-2">
          <text class="badge">Lv.{{userInfo.level}}</text>
          <text class="text-muted text-sm">{{userInfo.city || '未定位'}}</text>
        </view>
      </view>
    </view>
    <view class="edit-btn" bindtap="editProfile">编辑资料</view>
  </view>

  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-value">{{studyGold}}</text>
      <text class="stat-label">学习金</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{referralCount}}</text>
      <text class="stat-label">邀请好友</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{achievementsCount}}</text>
      <text class="stat-label">获得成就</text>
    </view>
  </view>

  <view class="card referral-card" bindtap="goToReferral">
    <view class="referral-header">
      <text class="referral-title">💰 推广员中心</text>
      <text class="referral-level">{{referralLevel.name}}</text>
    </view>
    <view class="referral-rates">
      <view class="rate-item">
        <text class="rate-label">直推佣金</text>
        <text class="rate-value">{{referralLevel.rate}}%</text>
      </view>
      <view class="rate-item">
        <text class="rate-label">间推佣金</text>
        <text class="rate-value">5%</text>
      </view>
    </view>
    <view class="referral-progress">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{referralProgress}}%"></view>
      </view>
      <text class="progress-text">距离下一等级还需邀请 {{referralNextCount}} 人</text>
    </view>
  </view>

  <view class="card">
    <view class="menu-list">
      <view class="menu-item" bindtap="goToAchievements">
        <text class="menu-icon">🏆</text>
        <text class="menu-text">成就系统</text>
        <text class="menu-badge">{{achievementsCount}}/15</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToFriends">
        <text class="menu-icon">👥</text>
        <text class="menu-text">我的好友</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToChatSettings">
        <text class="menu-icon">💬</text>
        <text class="menu-text">聊天设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToPrivacy">
        <text class="menu-icon">🔒</text>
        <text class="menu-text">隐私设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToReport">
        <text class="menu-icon">🚨</text>
        <text class="menu-text">举报/反馈</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="menu-item" bindtap="goToPrivacyPage">
      <text class="menu-icon">📜</text>
      <text class="menu-text">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToTerms">
      <text class="menu-icon">📋</text>
      <text class="menu-text">用户协议</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToHelp">
      <text class="menu-icon">❓</text>
      <text class="menu-text">帮助中心</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-btn" bindtap="logout">退出登录</view>
</view>
