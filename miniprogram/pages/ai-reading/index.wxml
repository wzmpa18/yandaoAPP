<view class="container">
  <!-- 选书界面 -->
  <view wx:if="{{!showReading}}">
    <view class="header">
      <view class="back-btn" bindtap="goBack">
        <text class="back-icon">←</text>
      </view>
      <text class="title">📚 AI选词阅读</text>
      <view class="placeholder"></view>
    </view>

    <view class="level-filter">
      <view 
        wx:for="{{levels}}" 
        wx:key="item" 
        class="level-btn {{selectedLevel === item ? 'active' : ''}}"
        bindtap="selectLevel"
        data-level="{{item}}"
      >
        <text>{{item === 'all' ? '全部' : item}}</text>
      </view>
    </view>

    <scroll-view scroll-y class="books-list">
      <view 
        wx:for="{{getFilteredBooks()}}" 
        wx:key="id" 
        class="book-card"
        bindtap="openBook"
        data-id="{{item.id}}"
      >
        <view class="book-cover">{{item.cover}}</view>
        <view class="book-info">
          <view class="book-title-row">
            <text class="book-title">{{item.title}}</text>
            <text class="book-title-zh">{{item.titleZh}}</text>
          </view>
          <text class="book-author">✍️ {{item.author}}</text>
          <view class="book-meta">
            <text class="book-level">Lv.{{item.level}}</text>
            <text class="book-category">{{item.category}}</text>
            <text class="book-wordcount">{{item.wordCount}}词</text>
            <text class="book-time">⏱️ {{item.estimatedTime}}</text>
          </view>
          <text class="book-desc">{{item.description}}</text>
          <view wx:if="{{item.progress > 0}}" class="book-progress">
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{item.progress}}%" />
            </view>
            <text class="progress-text">已阅读 {{item.progress}}%</text>
          </view>
          <view class="book-vocab-preview">
            <text class="vocab-tag" wx:for="{{item.vocabulary.slice(0, 4)}}" wx:key="word">{{item.word}}</text>
            <text wx:if="{{item.vocabulary.length > 4}}" class="vocab-more">+{{item.vocabulary.length - 4}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 书籍详情弹窗 -->
    <view wx:if="{{showBookDetail && currentBook}}" class="modal-overlay" bindtap="closeDetail">
      <view class="detail-modal" catchtap>
        <view class="modal-header">
          <text class="modal-title">{{currentBook.title}}</text>
          <view class="close-btn" bindtap="closeDetail">✕</view>
        </view>
        <scroll-view scroll-y class="modal-body">
          <view class="modal-cover">{{currentBook.cover}}</view>
          <text class="modal-author">{{currentBook.author}}</text>
          <text class="modal-desc">{{currentBook.description}}</text>
          <view class="modal-stats">
            <view class="stat-item">
              <text class="stat-icon">📊</text>
              <text class="stat-value">{{currentBook.level}}</text>
              <text class="stat-label">难度等级</text>
            </view>
            <view class="stat-item">
              <text class="stat-icon">📝</text>
              <text class="stat-value">{{currentBook.wordCount}}</text>
              <text class="stat-label">单词数</text>
            </view>
            <view class="stat-item">
              <text class="stat-icon">⏱️</text>
              <text class="stat-value">{{currentBook.estimatedTime}}</text>
              <text class="stat-label">预计时长</text>
            </view>
          </view>
          
          <view class="chapter-list">
            <text class="section-label">📖 章节列表 ({{currentBook.chapters.length}}章)</text>
            <view class="chapter-item" wx:for="{{currentBook.chapters}}" wx:key="title" bindtap="startReading" data-chapter="{{index}}">
              <text class="chapter-icon">📄</text>
              <text class="chapter-title">{{item.title}}</text>
              <text class="chapter-arrow">›</text>
            </view>
          </view>

          <view class="vocab-section">
            <text class="section-label">📝 核心词汇 ({{currentBook.vocabulary.length}})</text>
            <view class="vocab-grid">
              <view class="vocab-item" wx:for="{{currentBook.vocabulary}}" wx:key="word">
                <text class="vocab-word">{{item.word}}</text>
                <text class="vocab-meaning">{{item.meaning}}</text>
              </view>
            </view>
          </view>

          <view class="grammar-section">
            <text class="section-label">📚 语法要点</text>
            <view class="grammar-tag" wx:for="{{currentBook.grammarPoints}}" wx:key="*this">
              ✓ {{item}}
            </view>
          </view>

          <button class="start-btn" bindtap="startReading">📖 开始阅读</button>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- 阅读界面 -->
  <view wx:if="{{showReading && currentChapter}}" class="reading-view">
    <view class="reading-header">
      <view class="reading-back" bindtap="closeReading">← 返回</view>
      <text class="reading-title">{{currentChapter.title}}</text>
      <view class="reading-bookmark-btn" bindtap="completeChapter">✓ 完成</view>
    </view>

    <view class="reading-progress-bar">
      <view class="progress-fill" style="width: {{readingProgress}}%"></view>
      <text class="progress-text">{{readingProgress}}%</text>
    </view>

    <scroll-view scroll-y class="reading-content" bindscroll="onReadingScroll" scroll-with-animation>
      <view class="reading-text">
        <text class="paragraph">{{currentChapter.content}}</text>
      </view>

      <view class="reading-vocab-inline">
        <text class="section-label">📝 本章词汇</text>
        <view class="inline-vocab-list">
          <view class="inline-vocab-item {{bookmarkedWords.indexOf(item.word) > -1 ? 'bookmarked' : ''}}" 
            wx:for="{{currentBook.vocabulary}}" wx:key="word"
            bindtap="onWordTap" data-word="{{item.word}}">
            <text class="inline-word">{{item.word}}</text>
            <text class="inline-meaning" wx:if="{{showWordMeaning === item.word}}">{{item.meaning}}</text>
            <text class="bookmark-star" catchtap="toggleBookmark" data-word="{{item.word}}">
              {{bookmarkedWords.indexOf(item.word) > -1 ? '★' : '☆'}}
            </text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
