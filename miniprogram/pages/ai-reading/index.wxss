.container {
  min-height: 100vh;
  background: #f8fafc;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #22c55e;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
}

.back-icon {
  color: #fff;
  font-size: 36rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.placeholder {
  width: 60rpx;
}

.level-filter {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 15rpx;
  background: #fff;
}

.level-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #64748b;
}

.level-btn.active {
  background: #22c55e;
  color: #fff;
}

.books-list {
  height: calc(100vh - 200rpx);
  padding: 20rpx 30rpx;
}

.book-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.book-cover {
  font-size: 100rpx;
  margin-right: 25rpx;
}

.book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.book-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.book-author {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.book-meta {
  display: flex;
  gap: 15rpx;
  margin-bottom: 10rpx;
}

.book-level {
  font-size: 22rpx;
  color: #22c55e;
  background: #f0fdf4;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.book-wordcount {
  font-size: 22rpx;
  color: #64748b;
}

.book-time {
  font-size: 22rpx;
  color: #64748b;
}

.book-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 15rpx;
}

.book-progress {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #e2e8f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #22c55e, #16a34a);
  border-radius: 6rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #64748b;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
}

.detail-modal {
  width: 100%;
  background: #fff;
  border-radius: 30rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: #22c55e;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  color: #fff;
  font-size: 30rpx;
}

.modal-body {
  padding: 40rpx 30rpx;
  text-align: center;
}

.modal-cover {
  font-size: 150rpx;
  margin-bottom: 20rpx;
}

.modal-author {
  font-size: 28rpx;
  color: #64748b;
  display: block;
  margin-bottom: 20rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #1e293b;
  display: block;
  margin-bottom: 30rpx;
}

.modal-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 5rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
}

.start-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #22c55e, #16a34a);
  border-radius: 48rpx;
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}