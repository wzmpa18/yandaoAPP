.page-header {
  text-align: center;
  padding: 40rpx 0;
}

.page-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1e293b;
}

.page-subtitle {
  font-size: 28rpx;
  color: #64748b;
  margin-top: 12rpx;
  display: block;
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #64748b;
  transition: all 0.3s ease;
}

.filter-tab.active {
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  color: #ffffff;
}

.city-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.city-btn {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.city-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.city-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
}

.city-arrow {
  font-size: 20rpx;
  color: #94a3b8;
  margin-left: 8rpx;
}

.search-btn {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f1f5f9;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #94a3b8;
}

.friend-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.friend-card:last-child {
  margin-bottom: 0;
}

.friend-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.friend-info {
  flex: 1;
}

.friend-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.friend-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.friend-lang {
  font-size: 22rpx;
  color: #22c55e;
  background: #dcfce7;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.friend-dist {
  font-size: 22rpx;
  color: #64748b;
}

.friend-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
  display: block;
}

.friend-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.friend-tag {
  font-size: 20rpx;
  color: #64748b;
  background: #e2e8f0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.add-btn {
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  color: #ffffff;
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.added-btn {
  background: #f1f5f9;
  color: #94a3b8;
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.circle-entry {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
  border-radius: 20rpx;
}

.circle-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.circle-info {
  flex: 1;
}

.circle-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.circle-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.circle-arrow {
  font-size: 40rpx;
  color: #64748b;
}
