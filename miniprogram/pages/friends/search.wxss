.search-header {
  padding: 24rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: 40rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.clear-btn {
  font-size: 28rpx;
  color: #94a3b8;
  padding: 0 16rpx;
}

.filter-section {
  display: flex;
  gap: 20rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.filter-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.filter-text {
  font-size: 26rpx;
  color: #475569;
}

.filter-arrow {
  font-size: 20rpx;
  color: #94a3b8;
  margin-left: 8rpx;
}

.search-results {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.result-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.result-info {
  flex: 1;
}

.result-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.result-lang {
  font-size: 22rpx;
  color: #22c55e;
  background: #dcfce7;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.result-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.add-btn {
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  color: #ffffff;
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #64748b;
}

.empty-hint {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 12rpx;
}
