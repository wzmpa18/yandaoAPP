.container {
  min-height: 100vh;
  background: #f8fafc;
  padding-bottom: 30rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #22c55e;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
}

.back-icon {
  color: #fff;
  font-size: 36rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.placeholder {
  width: 60rpx;
}

.words-section {
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 20rpx;
  display: block;
}

.words-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.word-item {
  background: #fff;
  padding: 25rpx;
  border-radius: 15rpx;
  border: 2rpx solid #e2e8f0;
}

.word-item.selected {
  border-color: #22c55e;
  background: #f0fdf4;
}

.word-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 8rpx;
}

.word-phonetic {
  font-size: 26rpx;
  color: #64748b;
  display: block;
  margin-bottom: 5rpx;
}

.word-meaning {
  font-size: 24rpx;
  color: #94a3b8;
}

.practice-section {
  padding: 30rpx;
}

.word-display {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  border-radius: 25rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.display-word {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 15rpx;
}

.display-phonetic {
  font-size: 32rpx;
  color: rgba(255,255,255,0.9);
  display: block;
  margin-bottom: 10rpx;
}

.display-meaning {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.score-display {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.score-label {
  font-size: 28rpx;
  color: #64748b;
  display: block;
  margin-bottom: 20rpx;
}

.score-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f0fdf4, #dcfce7);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.score-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #22c55e;
}

.score-unit {
  font-size: 28rpx;
  color: #22c55e;
}

.feedback-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.phoneme-analysis {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.analysis-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 20rpx;
  display: block;
}

.phoneme-item {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.phoneme-item:last-child {
  border-bottom: none;
}

.phoneme-text {
  width: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.phoneme-status {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.phoneme-status.good {
  background: #dcfce7;
  color: #22c55e;
}

.phoneme-status.warning {
  background: #fef3c7;
  color: #f59e0b;
}

.phoneme-status.bad {
  background: #fee2e2;
  color: #ef4444;
}

.phoneme-tip {
  flex: 1;
  font-size: 24rpx;
  color: #64748b;
}

.record-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #22c55e, #16a34a);
  border-radius: 50rpx;
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-btn.recording {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}