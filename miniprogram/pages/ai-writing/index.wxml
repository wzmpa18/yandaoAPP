<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="title">✍️ AI作文教练</text>
    <view class="placeholder"></view>
  </view>

  <view class="main-content">
    <!-- 语言选择 -->
    <view class="lang-selector">
      <text class="lang-label">写作语言：</text>
      <view class="lang-current" bindtap="toggleLangPicker">
        <text>{{languages.find(l => l.code === lang).name}}</text>
        <text class="lang-arrow">▾</text>
      </view>
    </view>
    <view class="lang-dropdown" wx:if="{{showLangPicker}}">
      <view class="lang-option {{lang === item.code ? 'active' : ''}}" 
        wx:for="{{languages}}" wx:key="code"
        bindtap="selectLang" data-lang="{{item.code}}">
        {{item.name}}
      </view>
    </view>

    <view class="input-section">
      <text class="section-label">输入文本</text>
      <textarea 
        class="input-textarea"
        placeholder="请输入需要批改的文本..."
        value="{{input}}"
        bindinput="onInput"
        auto-height
        maxlength="2000"
      />
      <button 
        class="analyze-btn {{loading ? 'loading' : ''}}" 
        bindtap="analyzeText"
        disabled="{{loading || !input}}"
      >
        <text>{{loading ? '🤖 AI分析中...' : '📝 开始分析'}}</text>
      </button>
    </view>

    <!-- AI总结 -->
    <view wx:if="{{aiSummary}}" class="result-section summary-section">
      <text class="section-title">🤖 AI总体评价</text>
      <view class="summary-box">{{aiSummary}}</view>
    </view>

    <!-- 语法错误 -->
    <view wx:if="{{errors.length > 0}}" class="result-section">
      <text class="section-title">🚨 发现 {{errors.length}} 个问题</text>
      <view wx:for="{{errors}}" wx:key="index" class="error-item">
        <view class="error-header">
          <text class="error-rule">{{item.rule || '语法'}}</text>
          <text class="error-type">{{item.message}}</text>
        </view>
        <view wx:if="{{item.text}}" class="error-highlight">
          <text class="error-text">❌ {{item.text}}</text>
        </view>
        <text class="error-suggestion">💡 {{item.suggestion}}</text>
      </view>
    </view>

    <!-- 优化建议 -->
    <view wx:if="{{improvements.length > 0}}" class="result-section">
      <text class="section-title">✨ 优化建议</text>
      <view wx:for="{{improvements}}" wx:key="index" class="improvement-item">
        <view wx:if="{{item.original}}" class="improvement-row">
          <view class="improvement-original">
            <text class="label">原句：</text>
            <text class="text">{{item.original}}</text>
          </view>
          <view class="improvement-arrow">→</view>
          <view class="improvement-improved">
            <text class="label">优化：</text>
            <text class="text">{{item.improved}}</text>
          </view>
        </view>
        <text class="improvement-reason">💬 {{item.reason}}</text>
      </view>
    </view>

    <!-- 完美 -->
    <view wx:if="{{!loading && analyzedText && errors.length === 0 && improvements.length === 0}}" class="success-section">
      <text class="success-icon">🎉</text>
      <text class="success-text">太棒了！您的文本没有发现问题</text>
      <text class="success-sub">继续保持，你的写作水平很棒！</text>
    </view>
  </view>
</view>
