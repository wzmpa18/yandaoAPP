<view class="container">
  <view class="page-header">
    <text class="page-title">💬 学习圈</text>
    <text class="page-subtitle">按语言分社群，一起学习进步</text>
  </view>

  <view class="language-tabs">
    <scroll-view scroll-x class="tabs-scroll">
      <view class="tabs-list">
        <view class="lang-tab {{selectedLang === item.code ? 'active' : ''}}" 
          wx:for="{{languages}}" wx:key="code"
          bindtap="selectLang" data-lang="{{item.code}}">
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="post-list">
    <view wx:if="{{getFilteredPosts().length === 0}}" class="empty-state">
      <text class="empty-icon">📝</text>
      <text class="empty-text">还没有{{selectedLang === 'all' ? '' : languages.find(l => l.code === selectedLang).name + '的'}}动态</text>
      <text class="empty-sub">快来发布第一条吧！</text>
    </view>

    <view class="post-card" wx:for="{{getFilteredPosts()}}" wx:key="id">
      <view class="post-header">
        <view class="post-avatar">{{item.author.charAt(0)}}</view>
        <view class="post-author-info">
          <view class="post-author-row">
            <text class="post-author">{{item.author}}</text>
            <text wx:if="{{item.isMine}}" class="post-mine-tag">我的</text>
          </view>
          <text class="post-time">{{item.time}}</text>
        </view>
        <view wx:if="{{item.isMine}}" class="post-menu" bindtap="deletePost" data-post-id="{{item.id}}">🗑</view>
        <view wx:else class="post-menu">⋮</view>
      </view>
      <text class="post-content">{{item.content}}</text>
      <view class="post-images" wx:if="{{item.images && item.images.length}}">
        <image class="post-img" wx:for="{{item.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
      </view>
      <view class="post-stats">
        <view class="stat-item" bindtap="likePost" data-post-id="{{item.id}}">
          <text class="stat-icon">{{item.liked ? '❤️' : '🤍'}}</text>
          <text class="stat-text">{{item.likes}}</text>
        </view>
        <view class="stat-item" bindtap="commentPost" data-post-id="{{item.id}}">
          <text class="stat-icon">💬</text>
          <text class="stat-text">{{item.comments}}</text>
        </view>
        <view class="stat-item" bindtap="sharePost">
          <text class="stat-icon">🔗</text>
          <text class="stat-text">分享</text>
        </view>
      </view>
    </view>
  </view>

  <view class="fab-button" bindtap="goToPost">
    <text class="fab-icon">✏️</text>
  </view>
</view>
