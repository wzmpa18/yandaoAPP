<view class="container">
  <view class="page-header">
    <text class="page-title">💬 学习圈</text>
    <text class="page-subtitle">按语言分社群，一起学习进步</text>
  </view>

  <view class="language-tabs">
    <scroll-view scroll-x class="tabs-scroll">
      <view class="tabs-list">
        <view class="lang-tab active" wx:for="{{languages}}" wx:key="code">
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="post-list">
    <view class="post-card" wx:for="{{posts}}" wx:key="id">
      <view class="post-header">
        <view class="post-avatar">{{item.author.charAt(0)}}</view>
        <view class="post-author-info">
          <text class="post-author">{{item.author}}</text>
          <text class="post-time">{{item.time}}</text>
        </view>
        <view class="post-menu">⋮</view>
      </view>
      <text class="post-content">{{item.content}}</text>
      <view class="post-images" wx:if="{{item.images.length}}">
        <image class="post-img" wx:for="{{item.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
      </view>
      <view class="post-stats">
        <view class="stat-item" bindtap="likePost">
          <text class="stat-icon">{{item.liked ? '❤️' : '🤍'}}</text>
          <text class="stat-text">{{item.likes}}</text>
        </view>
        <view class="stat-item" bindtap="commentPost">
          <text class="stat-icon">💬</text>
          <text class="stat-text">{{item.comments}}</text>
        </view>
        <view class="stat-item" bindtap="sharePost">
          <text class="stat-icon">🔗</text>
          <text class="stat-text">分享</text>
        </view>
      </view>
    </view>
  </view>

  <view class="fab-button" bindtap="goToPost">
    <text class="fab-icon">✏️</text>
  </view>
</view>
